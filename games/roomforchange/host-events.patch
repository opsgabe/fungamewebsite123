@@ -0,0 +1,20 @@
+package com.sturdyhelmetgames.roomforchange;
+
+/**
+ * Lets a platform launcher observe game progress (start, artifact pickups,
+ * game over, win). The web build forwards these to the host page.
+ */
+public class GameEvents {
+
+	public interface Listener {
+		void onEvent(String name);
+	}
+
+	public static Listener listener;
+
+	public static void fire(String name) {
+		if (listener != null) {
+			listener.onEvent(name);
+		}
+	}
+}
